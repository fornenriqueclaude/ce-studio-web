# Formulario de contacto (Resend) — configurar en el panel del hosting, no en el repositorio.
# Clave de API de Resend (https://resend.com/api-keys), con permiso solo de envío.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Destinatario(s) de los avisos, separados por comas. [PENDIENTE: email de contacto]
CONTACT_TO=hola@example.com
# Remitente: debe pertenecer a un dominio verificado en Resend. [PENDIENTE: dominio]
CONTACT_FROM="C&E Studio <web@example.com>"
