---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Loader from '../components/Loader.astro';
import LoaderHead from '../components/LoaderHead.astro';
import DemoSection from '../components/DemoSection.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Costs from '../components/Costs.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <LoaderHead slot="head" />
  <Loader />
  <Hero />
  <DemoSection />
  <Manifesto />
  <Services />
  <Process />
  <Costs />
  <Team />

  <Contact />
</Base>

<script>
  import { initReveals } from '../scripts/reveal';
  initReveals();
</script>
