---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Loader from '../components/Loader.astro';
import LoaderHead from '../components/LoaderHead.astro';

// Secciones provisionales (Fase 1): solo estructura y anclas para la navbar.
const sections = [
  { id: 'manifiesto', eyebrow: 'Qué hacemos', title: 'Manifiesto', phase: 3 },
  { id: 'servicios', eyebrow: 'Servicios', title: 'Lo que construimos', phase: 3 },
  { id: 'como-trabajamos', eyebrow: 'Proceso', title: 'Cómo trabajamos', phase: 3 },
  { id: 'costes', eyebrow: 'Modelo', title: 'Costes bajo control', phase: 3 },
  { id: 'stack', eyebrow: 'Tecnología', title: 'Stack', phase: 3 },
  { id: 'equipo', eyebrow: 'Equipo', title: 'Quiénes somos', phase: 3 },
  { id: 'contacto', eyebrow: 'Contacto', title: 'Cuéntanos tu proyecto', phase: 4 },
];
---

<Base>
  <LoaderHead slot="head" />
  <Loader />
  <Hero />

  {
    sections.map((s) => (
      <section
        id={s.id}
        class:list={['border-t border-line py-32', s.id === 'costes' && 'theme-light']}
        aria-labelledby={`${s.id}-title`}
      >
        <div class="container-site">
          <p class="eyebrow mb-4">{s.eyebrow}</p>
          <h2 id={`${s.id}-title`} class="font-display text-h2 tracking-display">
            {s.title}
          </h2>
          <p class="mt-6 font-mono text-sm text-fg-muted">— Contenido en la fase {s.phase}.</p>
        </div>
      </section>
    ))
  }
</Base>
