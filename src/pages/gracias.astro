---
// Destino del envío sin JS cuando el mensaje se ha enviado correctamente.
import Base from '../layouts/Base.astro';
---

<Base title="Mensaje enviado" description="Hemos recibido tu mensaje." noindex>
  <section class="container-site flex min-h-[80svh] flex-col justify-center pt-(--nav-h)">
    <p class="eyebrow mb-6">Contacto</p>
    <h1 class="font-display text-h2 tracking-display">Gracias, hemos recibido tu mensaje.</h1>
    <p class="mt-6 max-w-xl text-lead text-fg-muted">Te responderemos lo antes posible.</p>
    <p class="mt-10"><a href="/" class="btn-accent">Volver al inicio <span aria-hidden="true">→</span></a></p>
  </section>
</Base>
