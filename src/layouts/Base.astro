---
import '../styles/global.css';

import Fonts from '../components/Fonts.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  /** Título de la página. Si se omite, se usa el título de la home. */
  title?: string;
  description?: string;
  /** Ruta absoluta o relativa a la imagen Open Graph (1200×630 recomendado). */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  // [PENDIENTE: imagen Open Graph 1200×630] — de momento, el favicon grande.
  image = '/brand/favicon-512.png',
  noindex = false,
} = Astro.props;

const fullTitle = title
  ? `${title} · ${SITE.name}`
  : `${SITE.name} — Software a medida para pequeñas empresas`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/brand/favicon-512.png', Astro.site).href,
  description: SITE.description,
  address: { '@type': 'PostalAddress', ...SITE.address },
  areaServed: { '@type': 'Country', name: 'España' },
  founder: SITE.founders.map((name) => ({ '@type': 'Person', name })),
  ...(SITE.email ? { email: SITE.email } : {}),
};
// Evita que un "</script>" dentro de los datos cierre la etiqueta.
const jsonLd = JSON.stringify(organization).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fonts />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#070707" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/favicon-512.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Logotipo de C&E Studio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="bg-bg text-fg font-body">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Navbar />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
