---
/*
 * Fuentes self-hosted (@fontsource), solo subconjunto latino: cubre todo el
 * español (á, ñ, ¿, ¡, €…) y evita declarar cirílico, griego, etc.
 * Outfit e Inter son variables (un único archivo para todos los pesos) y se precargan.
 * JetBrains Mono es decorativa: sin precarga.
 */
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import outfit from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const fontFaces = [
  ['Outfit Variable', outfit],
  ['Inter Variable', inter],
]
  .map(
    ([family, src]) =>
      `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:100 900;src:url(${src}) format('woff2-variations');unicode-range:${latinRange}}`,
  )
  .join('');
---

<link rel="preload" href={outfit} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontFaces} />
