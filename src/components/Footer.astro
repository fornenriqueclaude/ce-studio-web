---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logo-white-trim.png';
import { LEGAL_LINKS, NAV_LINKS, SITE, formatPhone, whatsappUrl } from '../consts';
import { LANDINGS, landingHref } from '../data/landings';
---

<footer class="border-t border-line">
  <div class="container-site grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-12 lg:col-span-4">
      <a href={url('/')} class="inline-block" aria-label={`${SITE.name} — inicio`}>
        <Image src={logoWhite} alt="" width={160} densities={[1, 2]} class="h-auto w-32 md:w-40" />
      </a>
      <p class="mt-6 max-w-xs text-sm text-fg-muted">
        Software a medida y plataformas SaaS para pequeñas empresas.
      </p>
    </div>

    <nav class="md:col-span-3 lg:col-span-2" aria-label="Secciones">
      <p class="eyebrow mb-4">Estudio</p>
      <ul class="space-y-2 text-sm">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="link-underline text-fg-muted transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="md:col-span-5 lg:col-span-3" aria-label="Servicios">
      <p class="eyebrow mb-4">Servicios</p>
      <ul class="space-y-2 text-sm">
        {
          LANDINGS.map((l) => (
            <li>
              <a href={url(landingHref(l))} class="link-underline text-fg-muted transition-colors hover:text-fg">
                {l.nav}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-4 lg:col-span-3">
      <p class="eyebrow mb-4">Contacto</p>
      <ul class="space-y-2 text-sm text-fg-muted">
        <li>
          {
            SITE.email ? (
              <a href={`mailto:${SITE.email}`} class="link-underline text-fg">
                {SITE.email}
              </a>
            ) : (
              <span>[PENDIENTE: email de contacto]</span>
            )
          }
        </li>
        {SITE.phones.map((p) => (
          <li>
            <a href={`tel:${p}`} class="link-underline text-fg">
              {formatPhone(p)}
            </a>
          </li>
        ))}
        <li>
          <a href={whatsappUrl()} class="link-underline text-fg" target="_blank" rel="noopener">
            WhatsApp
          </a>
          <span aria-hidden="true"> · </span>
          <a href={SITE.instagram.url} class="link-underline text-fg" target="_blank" rel="noopener">
            Instagram
          </a>
        </li>
        <li>{SITE.locations}</li>
        <li>{SITE.remote}</li>
      </ul>
    </div>
  </div>

  <div class="container-site flex flex-col gap-4 border-t border-line py-6 text-xs text-fg-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {SITE.year} {SITE.legalName}</p>
    <nav aria-label="Legal">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          LEGAL_LINKS.map((link) => (
            <li>
              <a href={link.href} class="link-underline transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
