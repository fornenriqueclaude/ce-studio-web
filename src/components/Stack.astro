---
/**
 * Capacidades: dos marquees en sentidos opuestos cuya velocidad (y sentido) reacciona a la
 * velocidad del scroll. Lo que hacemos, sin nombres de proveedores ni tecnologías.
 * Sin JS o con reduced motion: lista estática que se ajusta en varias líneas.
 */
import SectionHeading from './SectionHeading.astro';

const rows = [
  ['Aplicaciones web', 'Paneles', 'Automatizaciones', 'Bases de datos', 'Nube'],
  ['Inteligencia artificial', 'SMS', 'Llamadas', 'Integraciones', 'Soporte'],
];
---

<section id="stack" class="stack" aria-labelledby="stack-title">
  <div class="container-site">
    <SectionHeading
      id="stack-title"
      eyebrow="Tecnología"
      title="Todo lo que necesitas"
      lead="Elegimos la tecnología según el proyecto. Tú solo ves que funciona."
    />
  </div>

  <ul class="sr-only">
    {rows.flat().map((name) => <li>{name}</li>)}
  </ul>

  <div class="marquees" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class="marquee" data-marquee data-dir={r === 0 ? '-1' : '1'}>
          <div class="marquee-track" data-marquee-track>
            {[0, 1].map((copy) => (
              <div class="marquee-group" data-copy={copy}>
                {row.map((name, i) => (
                  <>
                    <span class:list={['item', (i + r) % 2 === 1 && 'item--outline']}>{name}</span>
                    <span class="sep" />
                  </>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stack {
    padding-block: clamp(6rem, 12vw, 10rem);
    overflow: clip;
  }
  .marquees {
    display: grid;
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
    margin-top: clamp(3rem, 7vw, 5rem);
    border-block: 1px solid var(--line);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .marquee {
    overflow: hidden;
  }

  /* Estático (por defecto): una línea que se ajusta, sin duplicados */
  .marquee-track {
    display: flex;
    padding-inline: var(--gutter);
  }
  .marquee-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25em 0.5em;
  }
  .marquee-group[data-copy='1'] {
    display: none;
  }
  .marquee:not(.is-running) .sep:last-child {
    display: none;
  }

  /* En movimiento (lo activa el JS) */
  .marquee.is-running .marquee-track {
    width: max-content;
    padding-inline: 0;
    will-change: transform;
  }
  .marquee.is-running .marquee-group {
    flex-wrap: nowrap;
    padding-right: 0.5em;
  }
  .marquee.is-running .marquee-group[data-copy='1'] {
    display: flex;
  }

  .item {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7.5vw, 7.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .item--outline {
    color: transparent;
    -webkit-text-stroke: 1px var(--fg-muted);
  }
  /* Separador: pequeño paralelogramo, eco del corte de la E */
  .sep {
    width: 0.45em;
    height: 0.14em;
    font-size: clamp(2.5rem, 7.5vw, 7.5rem);
    background: var(--accent);
    transform: skewX(-38deg);
    flex: none;
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../scripts/motion';

  const marquees = Array.from(document.querySelectorAll<HTMLElement>('[data-marquee]'));
  const section = document.getElementById('stack');

  if (marquees.length && section) {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      const BASE = 60; // px/s
      let boost = 0; // extra por velocidad de scroll (suavizado)
      let targetBoost = 0;
      let scrollDir = 1;

      const rows = marquees.map((el) => {
        el.classList.add('is-running');
        const track = el.querySelector<HTMLElement>('[data-marquee-track]')!;
        const group = el.querySelector<HTMLElement>('[data-copy="0"]')!;
        const dir = Number(el.dataset['dir'] ?? 1);
        const setX = gsap.quickSetter(track, 'x', 'px');
        return { track, group, dir, setX, x: 0, width: group.offsetWidth };
      });

      const measure = () => rows.forEach((r) => (r.width = r.group.offsetWidth));
      window.addEventListener('resize', measure);
      document.fonts?.ready.then(measure);

      const tick = (_t: number, deltaMs: number) => {
        const dt = Math.min(deltaMs, 50) / 1000;
        boost += (targetBoost - boost) * 0.08;
        targetBoost *= 0.92; // la inercia se apaga si se deja de hacer scroll
        for (const r of rows) {
          r.x += r.dir * scrollDir * (BASE + boost) * dt;
          r.x = gsap.utils.wrap(-r.width, 0, r.x);
          r.setX(r.x);
        }
      };

      const st = ScrollTrigger.create({
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        onUpdate: (self) => {
          targetBoost = Math.min(Math.abs(self.getVelocity()) * 0.35, 1400);
          scrollDir = self.direction;
        },
        onToggle: (self) => (self.isActive ? gsap.ticker.add(tick) : gsap.ticker.remove(tick)),
      });

      return () => {
        st.kill();
        gsap.ticker.remove(tick);
        window.removeEventListener('resize', measure);
        rows.forEach((r) => {
          r.track.style.transform = '';
          r.track.parentElement?.classList.remove('is-running');
        });
      };
    });
  }
</script>
