---
/**
 * Equipo: retratos en blanco y negro editorial que pasan a color al pasar el ratón
 * (solo opacidad) y con un leve parallax dentro del marco. Fotos encuadradas igual
 * (4:5, ojos a la misma altura) y servidas en AVIF/WebP con astro:assets.
 */
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import carlosBw from '../assets/team/carlos-bw.jpg';
import carlosColor from '../assets/team/carlos-color.jpg';
import enriqueBw from '../assets/team/enrique-bw.jpg';
import enriqueColor from '../assets/team/enrique-color.jpg';

const people = [
  {
    name: 'Carlos Fornelino',
    role: 'Comercial y clientes',
    line: 'Tu punto de contacto: entiende tu negocio, prepara la propuesta y te acompaña durante todo el proyecto.',
    alt: 'Retrato de Carlos Fornelino, responsable comercial de C&E Studio',
    bw: carlosBw,
    color: carlosColor,
  },
  {
    name: 'Enrique Madruga',
    role: 'Desarrollo e infraestructura',
    line: 'Diseña y construye el software, lo pone en producción y se encarga de que funcione cada día.',
    alt: 'Retrato de Enrique Madruga, responsable de desarrollo e infraestructura de C&E Studio',
    bw: enriqueBw,
    color: enriqueColor,
  },
];

const widths = [480, 720, 960, 1200];
const sizes = '(min-width: 64rem) 30rem, (min-width: 48rem) 46vw, calc(100vw - 2.5rem)';
---

<section id="equipo" class="team" aria-labelledby="equipo-title">
  <div class="container-site">
    <SectionHeading
      id="equipo-title"
      eyebrow="Equipo"
      title="Quiénes somos"
      lead="Un estudio pequeño a propósito: hablas directamente con quien diseña y construye tu software."
    />

    <ul class="people">
      {
        people.map((p) => (
          <li class="person" data-reveal>
            <div class="portrait">
              <div class="photo" data-photo>
                <Picture src={p.bw} alt={p.alt} formats={['avif', 'webp']} widths={widths} sizes={sizes} class="photo-img" />
                <Picture
                  src={p.color}
                  alt=""
                  aria-hidden="true"
                  formats={['avif', 'webp']}
                  widths={widths}
                  sizes={sizes}
                  class="photo-img photo-color"
                />
              </div>
            </div>
            <div class="person-body">
              <p class="eyebrow">{p.role}</p>
              <h3 class="person-name">{p.name}</h3>
              <p class="person-line">{p.line}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team {
    padding-block: clamp(6rem, 12vw, 10rem);
  }
  .people {
    display: grid;
    gap: clamp(3rem, 6vw, 1.5rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  @media (min-width: 48rem) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      /* retratos contenidos: que cada uno quepa en pantalla con su texto */
      max-width: 62rem;
    }
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--bg-elev);
    isolation: isolate;
  }
  /* Fundido inferior hacia el fondo de la web */
  .portrait::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 30%;
    background: linear-gradient(to bottom, transparent, rgb(7 7 7 / 0.55));
    pointer-events: none;
  }
  .photo {
    position: absolute;
    inset: -6% 0;
  }
  .photo :global(picture),
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .photo :global(.photo-color) {
    opacity: 0;
    transition: opacity 700ms var(--ease-power3);
  }
  @media (hover: hover) and (pointer: fine) {
    .person:hover .photo :global(.photo-color) {
      opacity: 1;
    }
  }

  .person-body {
    margin-top: 1.5rem;
  }
  .person-name {
    margin-top: 0.75rem;
    font-size: var(--text-h3);
    line-height: 1.1;
  }
  .person-line {
    margin-top: 0.75rem;
    max-width: 40ch;
    color: var(--fg-muted);
  }
</style>

<script>
  import { gsap } from '../scripts/motion';

  const photos = Array.from(document.querySelectorAll<HTMLElement>('[data-photo]'));
  if (photos.length) {
    const mm = gsap.matchMedia();
    mm.add('(prefers-reduced-motion: no-preference)', () => {
      photos.forEach((photo) => {
        gsap.fromTo(
          photo,
          { yPercent: -4 },
          {
            yPercent: 4,
            ease: 'none',
            scrollTrigger: { trigger: photo.parentElement, start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      });
    });
  }
</script>
