---
/**
 * Pagas solo lo que usas — modelo de costes (sección en fondo claro).
 *  - Transición con corte diagonal (inspirado en los cortes de la E) a fondo claro: el
 *    plano claro tiene los bordes diagonales fijos (clip-path estático) y entra con transform.
 *  - Tarjeta de ejemplo con el desglose del consumo del mes por servicio: las barras crecen
 *    con el scroll. Sin JS o con reduced motion se muestra directamente el estado final.
 */
import SectionHeading from './SectionHeading.astro';

const model = [
  { term: 'Implantación', desc: 'Pago único por proyecto, facturado por hitos: al inicio y a la entrega.' },
  { term: 'Mantenimiento y SaaS', desc: 'Suscripción mensual: alojamiento, soporte, actualizaciones y evolución.' },
  { term: 'Consumo de terceros', desc: 'IA, SMS o voz se repercuten según el uso real, con el detalle de cada servicio en la factura.' },
];

// Ejemplo ilustrativo del reparto del consumo de un mes (no son datos de un cliente real)
const usage = [
  { service: 'IA', provider: 'asistentes', share: 62 },
  { service: 'SMS y voz', provider: 'mensajes y llamadas', share: 38 },
];
---

<section id="costes" class="costs theme-light" data-costs aria-labelledby="costes-title">
  <div class="costs-bg" data-costs-bg aria-hidden="true"></div>

  <div class="container-site costs-grid">
    <div class="costs-copy">
      <SectionHeading
        id="costes-title"
        eyebrow="Modelo"
        title="Pagas solo lo que usas"
        lead="Sin cuotas infladas ni paquetes que no necesitas. Los servicios de terceros se pagan según el uso real, y cada mes ves qué se ha consumido y por qué."
      />

      <dl class="model">
        {
          model.map((m) => (
            <div class="model-row" data-reveal>
              <dt>{m.term}</dt>
              <dd>{m.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div
      class="usage-card"
      data-usage
      role="img"
      aria-label="Ejemplo de desglose mensual del consumo por servicio: IA y SMS o voz, con su parte del total."
      data-reveal
    >
      <div aria-hidden="true">
        <div class="usage-head">
          <span>Consumo del mes</span>
          <span class="mono">desglose por servicio</span>
        </div>

        <p class="usage-title">Uso real</p>

        <ul class="usage-rows">
          {
            usage.map((u) => (
              <li class="usage-row">
                <div class="usage-label">
                  <span class="usage-service">{u.service}</span>
                  <span class="mono muted">{u.provider}</span>
                  <span class="usage-share">
                    <span data-usage-pct data-target={u.share}>{u.share}</span> %
                  </span>
                </div>
                <div class="usage-bar">
                  <span class="usage-fill" data-usage-fill data-target={u.share} style={`transform: scaleX(${u.share / 100})`} />
                </div>
              </li>
            ))
          }
        </ul>

        <div class="usage-foot">
          <span class="usage-pill"><span class="pill-dot"></span>Detalle en cada factura</span>
          <span class="mono muted">sin cuotas fijas de consumo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .costs {
    --cut: clamp(3.5rem, 9vw, 9rem);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: calc(var(--cut) + clamp(4rem, 8vw, 7rem));
  }
  /* El fondo claro lo pinta el plano diagonal, no la sección */
  .costs.theme-light {
    background-color: transparent;
  }
  .costs-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    clip-path: polygon(0 var(--cut), 100% 0, 100% calc(100% - var(--cut)), 0 100%);
  }

  .costs-grid {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .costs-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
    }
    .costs-copy {
      grid-column: 1 / span 6;
    }
    .usage-card {
      grid-column: 8 / span 5;
    }
  }

  .model {
    display: grid;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .model-row {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .model-row {
      grid-template-columns: 12rem 1fr;
      gap: 1.5rem;
    }
  }
  .model-row dt {
    font-family: var(--font-display);
    font-weight: 500;
  }
  .model-row dd {
    color: var(--fg-muted);
  }

  /* ---------- Tarjeta de consumo ---------- */
  .usage-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius-card) * 2);
    background: #fbfbf9;
    box-shadow: 0 30px 60px -30px rgb(7 7 7 / 0.25);
  }
  .usage-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
  .muted {
    color: var(--fg-muted);
  }
  .usage-title {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 4.75rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .usage-rows {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .usage-label {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.75rem;
  }
  .usage-service {
    font-weight: 500;
  }
  .usage-share {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .usage-bar {
    position: relative;
    height: 10px;
    margin-top: 0.75rem;
    border-radius: 999px;
    background: var(--bg-elev);
    overflow: hidden;
  }
  .usage-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--fg);
    transform-origin: left;
  }
  .usage-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .usage-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 1rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .pill-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-ink);
  }
</style>

<script>
  import { gsap } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-costs]');
  const bg = document.querySelector<HTMLElement>('[data-costs-bg]');
  const card = document.querySelector<HTMLElement>('[data-usage]');

  if (section && bg && card) {
    const fills = Array.from(card.querySelectorAll<HTMLElement>('[data-usage-fill]'));
    const pcts = Array.from(card.querySelectorAll<HTMLElement>('[data-usage-pct]'));
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      // El plano claro entra desde abajo: el corte diagonal "barre" la pantalla
      gsap.fromTo(
        bg,
        { yPercent: 14 },
        { yPercent: 0, ease: 'none', scrollTrigger: { trigger: section, start: 'top bottom', end: 'top 25%', scrub: true } },
      );

      // Las barras del desglose crecen con el scroll y los porcentajes las acompañan
      const tl = gsap.timeline({
        scrollTrigger: { trigger: card, start: 'top 80%', end: 'center 45%', scrub: 0.6 },
      });
      fills.forEach((fill, i) => {
        const target = Number(fill.dataset['target']) / 100;
        const counter = { v: 0 };
        const pct = pcts[i];
        tl.fromTo(fill, { scaleX: 0 }, { scaleX: target, ease: 'power2.out', duration: 1 }, i * 0.15).to(
          counter,
          {
            v: target * 100,
            ease: 'power2.out',
            duration: 1,
            onUpdate: () => {
              if (pct) pct.textContent = String(Math.round(counter.v));
            },
          },
          i * 0.15,
        );
      });

      return () => {
        fills.forEach((f) => (f.style.transform = `scaleX(${Number(f.dataset['target']) / 100})`));
        pcts.forEach((p) => (p.textContent = p.dataset['target'] ?? ''));
      };
    });
  }
</script>
